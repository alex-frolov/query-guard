<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         bootstrap="../../../vendor/autoload.php"
         cacheDirectory="../../../.phpunit.cache/fixture-tier2"
         colors="false">
    <testsuites>
        <testsuite name="fixture">
            <directory>Silent</directory>
        </testsuite>
    </testsuites>
    <extensions>
        <bootstrap class="QueryGuard\Extension">
            <parameter name="mode" value="report"/>
            <parameter name="tier2" value="true"/>
            <parameter name="large-tables" value="invoices, orders"/>
            <parameter name="query-in-loop-threshold" value="5"/>
            <parameter name="duplicate-threshold" value="3"/>
        </bootstrap>
    </extensions>
</phpunit>
