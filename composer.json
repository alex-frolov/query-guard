{
    "name": "alex-frolov/query-guard",
    "description": "Detects N+1, duplicate and otherwise problematic SQL queries during a regular PHPUnit run",
    "keywords": [
        "phpunit",
        "doctrine",
        "eloquent",
        "n-plus-one",
        "sql",
        "performance",
        "testing",
        "query",
        "explain"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/alex-frolov/query-guard",
    "authors": [
        {
            "name": "Aleksander Frolov",
            "email": "aleksander@frolov.guru",
            "homepage": "https://frolov.guru"
        }
    ],
    "support": {
        "issues": "https://github.com/alex-frolov/query-guard/issues",
        "source": "https://github.com/alex-frolov/query-guard"
    },
    "require": {
        "php": ">=8.2",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "doctrine/dbal": "^3.9 || ^4.0",
        "doctrine/orm": "^2.20 || ^3.0",
        "friendsofphp/php-cs-fixer": "^3.64",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/events": "^11.0 || ^12.0 || ^13.0",
        "phpstan/phpstan": "^2.1",
        "symfony/cache": "^6.4 || ^7.0 || ^8.0",
        "symfony/var-exporter": "^6.4 || ^7.0 || ^8.0"
    },
    "suggest": {
        "doctrine/dbal": "Doctrine adapter: query interception via a DBAL middleware (^3.0 || ^4.0)",
        "doctrine/orm": "Doctrine adapter: without it findings cannot name the lazy-loaded association, and n-plus-one stays a warning instead of an error (^2.20 || ^3.0)",
        "illuminate/database": "Eloquent adapter: query interception via DB::listen"
    },
    "autoload": {
        "psr-4": {
            "QueryGuard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "QueryGuard\\Test\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "QueryGuard\\Adapter\\Eloquent\\QueryGuardServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit",
        "coverage": "phpunit --coverage-text",
        "analyse": "phpstan analyse",
        "analyse-tests": "phpstan analyse --configuration=tools/phpstan/tests.neon",
        "fix": "php-cs-fixer fix --allow-risky=yes",
        "style": "php-cs-fixer fix --allow-risky=yes --dry-run --diff",
        "check": [
            "@test",
            "@analyse",
            "@analyse-tests",
            "@style"
        ]
    },
    "scripts-descriptions": {
        "coverage": "Line coverage over src. Needs pcov or Xdebug; without one PHPUnit says so and reports nothing.",
        "analyse-tests": "Static analysis of the suite itself, one level below src.",
        "style": "Reports style violations without touching anything. `check` uses this; `fix` applies them."
    },
    "minimum-stability": "stable"
}
